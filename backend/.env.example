# Django
SECRET_KEY=change-this-to-a-long-random-secret-key
DEBUG=True
ALLOWED_HOSTS=127.0.0.1,localhost

# CORS - frontend dev server address
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Assistant
# Provider: "openai" (any OpenAI-compatible /chat/completions endpoint) or "anthropic"
AI_PROVIDER=openai
# Leave empty to run without AI configured — the app will not crash, it will
# show a friendly "AI is not connected yet" message instead of a real reply.
AI_API_KEY=
# Optional overrides — sensible defaults are used per provider if left empty
AI_MODEL=
AI_API_BASE_URL=

# Optional commercial Open-Meteo key; without it the free public API is used.
OPEN_METEO_API_KEY=

# Password reset email delivery (configure a real SMTP provider in production)
EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
DEFAULT_FROM_EMAIL=
